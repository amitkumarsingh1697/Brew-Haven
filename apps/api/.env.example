# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brewhaven
PORT=8080
STAFF_TOKEN_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# "simulated" for the demo (no gateway account needed), or "razorpay"
PAYMENT_PROVIDER=simulated
SIMULATED_WEBHOOK_SECRET=change-me
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
